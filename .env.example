# Contact delivery. Configure either Resend or a private webhook.
RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@example.com
CONTACT_FROM_EMAIL=Portfolio <portfolio@example.com>
CONTACT_WEBHOOK_URL=
