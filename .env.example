# Public site configuration
NEXT_PUBLIC_SITE_URL=https://portfolio.example.com
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@example.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/example
NEXT_PUBLIC_LINKEDIN_URL=

# Legal notice: fill these before public deployment if an imprint is legally required.
